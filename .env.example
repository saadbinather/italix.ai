GEMINI_API_KEY=
GROQ_API_KEY=
CLOUD_PROVIDER=gemini

# Generate distinct high-entropy values locally. Never commit real tokens.
ITALIX_VIEWER_TOKEN=
ITALIX_OPERATOR_TOKEN=

# Next.js local operator unlock and HMAC session secrets (distinct, 32+ characters).
# Keep these server-side. Do not use NEXT_PUBLIC_ prefixes.
ITALIX_OPERATOR_UNLOCK_SECRET=
ITALIX_SESSION_SECRET=
